{
  "name": "pep-atlas-studio",
  "version": "1.6.0",
  "private": true,
  "description": "Atlas Studio — Event Storming guiado por jornadas de usuário. Build gera um único HTML estático.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @pep-atlas/domain && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck -w @pep-atlas/domain",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:e2e": "node tests/e2e/run-all.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.2"
  }
}
